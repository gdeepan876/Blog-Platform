{
  "name": "blog-platform-monorepo",
  "version": "1.0.0",
  "description": "Full-stack blog platform with comments, authentication, and moderation",
  "scripts": {
    "start": "npm run start:server",
    "start:server": "npm --prefix server run dev",
    "start:client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test",
    "build": "npm --prefix client run build"
  }
}

